---
import '../styles/global.css';
import { temas } from '../lib/temas.js';

const {
  titulo = 'Repaso · Implantación de aplicaciones web',
  descripcion = 'Material de repaso del módulo MF0493_3 del IFCD0210',
  apartadoActivo = null,
  sinMenu = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (ruta: string) => (ruta === '/' ? `${base}/` : `${base}${ruta}/`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{titulo}</title>
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>

    <header class="cabecera-sitio">
      <div class="contenedor cabecera-inner">
        <a class="marca" href={url('/')}>
          <span class="marca-titulo">Repaso MF0493_3</span>
          <span class="marca-sub">IFCD0210 · Implantación de aplicaciones web</span>
        </a>
        <nav class="nav-principal" aria-label="Navegación principal">
          <a href={url('/')}>Temario</a>
          <a href={url('/actividades')}>Actividades</a>
          <a href={url('/practica')}>Práctica</a>
          <a href={`${base}/checklist.html`}>Checklist</a>
          <a href={url('/imprimir')}>Imprimir</a>
        </nav>
      </div>
    </header>

    <div class="contenedor esquema">
      {!sinMenu && (
        <aside class="indice" aria-label="Índice de apartados">
          <p class="indice-titulo">Apartados</p>
          <ol>
            {temas.map((tema) => (
              <li>
                <a
                  href={url(`/tema/${tema.slug}`)}
                  aria-current={apartadoActivo === tema.numero ? 'page' : undefined}
                >
                  <span class="indice-num">{tema.numero}</span>
                  {tema.titulo}
                </a>
              </li>
            ))}
          </ol>
          <a class="indice-todo" href={url('/imprimir')}>Ver temario completo →</a>
          <a class="indice-todo" href={url('/practica')}>Hacer el test de repaso →</a>
        </aside>
      )}

      <main id="contenido" class={sinMenu ? 'contenido contenido-ancho' : 'contenido'}>
        <slot />
      </main>
    </div>

    <footer class="pie">
      <div class="contenedor">
        <p>
          Material de repaso · IFCD0210 — MF0493_3 ·{' '}
          <a href="https://github.com/canodelacuadra/repaso-mf0493-3">Repositorio en GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
