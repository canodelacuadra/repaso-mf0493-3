---
import BaseLayout from '../layouts/BaseLayout.astro';
import { introduccion, temas } from '../lib/temas.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (ruta: string) => (ruta === '/' ? `${base}/` : `${base}${ruta}/`);
---

<BaseLayout titulo="Repaso · MF0493_3 — Implantación de aplicaciones web">
  <section class="hero" set:html={introduccion} />

  <h2 id="temas" class="seccion-titulo">Los 8 apartados</h2>
  <p class="seccion-intro">
    Elige un apartado para repasarlo. También puedes
    <a href={url('/imprimir')}>imprimir el temario completo</a>.
  </p>

  <div class="tarjetas">
    {
      temas.map((tema) => (
        <a class="tarjeta" href={url(`/tema/${tema.slug}`)}>
          <span class="tarjeta-num">{String(tema.numero).padStart(2, '0')}</span>
          <h3>{tema.titulo}</h3>
          <p>{tema.resumen}</p>
          <span class="tarjeta-enlace">Repasar apartado →</span>
        </a>
      ))
    }
  </div>
</BaseLayout>
